# Optional private metallib corpus (mined data). Everything under local/ is user-supplied and must
# never be committed. Authored cases and hash-identified observations outside local/ are canonical.
crates/metal2vulkan-validation/corpus/local/
crates/metal2vulkan-validation/corpus/.index.sqlite
crates/metal2vulkan-validation/corpus/.index.sqlite-*
crates/metal2vulkan-validation/corpus/.index.sqlite.*
crates/metal2vulkan-validation/corpus/.transactions/
*.jsonl.tmp

