using namespace metal;

struct grd_in {
    float4 position [[position]];
    float2 uv [[user(locn0)]];
};

struct grd_out {
    half4 c0 [[color(0)]];
    half4 c1 [[color(1)]];
};

vertex grd_in grd_many_vertex(uint vid [[vertex_id]])
{
    float2 p = float2(float(vid & 1u), float(vid >> 1u));
    grd_in out;
    out.position = float4(p * 2.0 - 1.0, 0.0, 1.0);
    out.uv = p;
    return out;
}

